# Supabase - get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role — server-side only, for admin operations (payment callback)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL - change to your Vercel URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email — server-side only, never use NEXT_PUBLIC_ prefix
# Get API key from resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=ScanBite <noreply@yourdomain.com>
CONTACT_EMAIL=altenativeone@gmail.com

# ePays Payment Gateway — server-side only (no NEXT_PUBLIC_ prefix)
# Get these from your ePays merchant dashboard after onboarding
EPAYS_API_VERSION=3.3
EPAYS_API_ID=your_api_id
EPAYS_API_KEY=your_gateway_api_key         # gateway-scoped key (after subscribing to a gateway)
EPAYS_MERCHANT_GATEWAY=your_merchant_gateway_id
EPAYS_TEST_MODE=1                          # 0 = production, 1 = test
EPAYS_MODE_TYPE=test                       # localhost | localip | test | live
